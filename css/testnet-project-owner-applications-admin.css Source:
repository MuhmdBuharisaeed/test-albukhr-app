:root{color-scheme:light;--green:#0f7a3d;--ink:#17231b;--muted:#65736a;--line:#dce6df;--surface:#fff;--soft:#f4f8f5;--danger:#a33434}*{box-sizing:border-box}body{margin:0;background:#f5f8f6;color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.app-admin-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:28px max(20px,calc((100vw - 1100px)/2));background:#fff;border-bottom:1px solid var(--line)}.app-admin-header h1{margin:5px 0;font-size:clamp(22px,4vw,32px)}.app-admin-header p{margin:0;color:var(--muted)}.app-admin-kicker{font-size:11px;font-weight:800;letter-spacing:.14em;color:var(--green)}.app-admin-header a,.queue-toolbar button,.review-actions button{border:1px solid var(--line);border-radius:10px;padding:10px 14px;background:#fff;color:var(--ink);font-weight:700;text-decoration:none;cursor:pointer}.app-admin-main{max-width:1100px;margin:26px auto;padding:0 18px 48px}.queue-status{padding:13px 15px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--muted);margin-bottom:20px}.queue-status[data-state="error"]{color:var(--danger);border-color:#e8caca}.queue-toolbar{display:flex;align-items:center;justify-content:space-between;margin:12px 0}.queue-toolbar h2{font-size:19px}.application-queue{display:grid;gap:16px}.application-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 4px 14px rgba(17,48,27,.04)}.application-card h3{margin:0 0 5px;font-size:18px}.application-meta{color:var(--muted);font-size:13px;margin-bottom:15px}.application-status{display:inline-block;border-radius:20px;background:var(--soft);padding:5px 9px;color:var(--green);font-size:11px;font-weight:800;text-transform:uppercase}.owner-submission{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:14px 0}.owner-field{border:1px solid var(--line);border-radius:10px;padding:11px;background:#fbfdfb;min-width:0}.owner-field.full{grid-column:1/-1}.owner-field span{display:block;color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}.owner-field p{white-space:pre-wrap;overflow-wrap:anywhere;margin:0;line-height:1.45}.review-note{display:block;width:100%;min-height:74px;border:1px solid var(--line);border-radius:10px;padding:11px;font:inherit;resize:vertical}.review-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.review-actions button[data-decision="approved"]{background:var(--green);color:#fff;border-color:var(--green)}.review-actions button[data-decision="rejected"]{color:var(--danger);border-color:#e8caca}.review-actions button:disabled{opacity:.55;cursor:wait}.empty-queue{background:#fff;border:1px dashed var(--line);border-radius:15px;padding:30px;text-align:center;color:var(--muted)}@media(max-width:640px){.app-admin-header{align-items:flex-start;flex-direction:column}.owner-submission{grid-template-columns:1fr}.owner-field.full{grid-column:auto}.app-admin-main{padding-inline:12px}}
